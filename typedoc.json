{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/index.ts",
    "src/helpers/index.ts",
    "src/react/index.ts",
    "src/ai-sdk/index.ts",
    "src/test/index.ts",
    "src/worker/index.ts"
  ],
  "out": "docs/dist/api",
  "name": "Edgewise API",
  "readme": "none",
  "tsconfig": "tsconfig.json",
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "hideGenerator": true,
  "navigationLinks": {
    "Docs": "../index.html",
    "GitHub": "https://github.com/kucukkanat/edgewise"
  },
  "validation": {
    "notExported": false,
    "invalidLink": true
  }
}
